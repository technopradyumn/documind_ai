# ── Required ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional — enables TTS voice responses ────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Infrastructure (defaults match docker-compose.yml) ────────────────────────
MONGODB_URI=mongodb://admin:admin@localhost:27017
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379

# ── Neo4j (optional — for graph-based memory) ────────────────────────────────
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password

# ── Model selection ───────────────────────────────────────────────────────────
GEMINI_MODEL_FLASH=gemini-2.0-flash
GEMINI_MODEL_PRO=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ── App config ────────────────────────────────────────────────────────────────
QDRANT_COLLECTION=documind
UPLOADS_DIR=uploads
VOICE_ENABLED=true
MAX_AGENT_ITERATIONS=10
